{
  "name": "@racing-gang/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-check.mjs",
    "test:network": "node scripts/network-check.mjs",
    "test:hud": "node scripts/hud-check.mjs",
    "test:rooms": "node scripts/rooms-check.mjs",
    "test:results": "node scripts/results-check.mjs",
    "test:performance": "node scripts/performance-check.mjs",
    "test:service": "node scripts/service-check.mjs",
    "test:design": "node scripts/design-check.mjs",
    "test:garage": "node scripts/garage-check.mjs",
    "test:practice": "node scripts/practice-check.mjs"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.50.0",
    "@racing-gang/config": "workspace:*",
    "@racing-gang/sim": "workspace:*",
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-query": "^5.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.0",
    "three": "^0.180.0",
    "viem": "2.56.5",
    "wagmi": "^2.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "meshoptimizer": "1.3.0",
    "playwright": "^1.56.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
