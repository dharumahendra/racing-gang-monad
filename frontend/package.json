{
  "name": "@racing-gang/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-check.mjs",
    "test:network": "node scripts/network-check.mjs",
    "test:hud": "node scripts/hud-check.mjs",
    "test:rooms": "node scripts/rooms-check.mjs",
    "test:results": "node scripts/results-check.mjs",
    "test:performance": "node scripts/performance-check.mjs"
  },
  "dependencies": {
    "@racing-gang/config": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.0",
    "viem": "2.56.5",
    "wagmi": "^2.0.0",
    "zustand": "^5.0.0",
    "@racing-gang/sim": "workspace:*",
    "@react-three/fiber": "^9.0.0",
    "three": "^0.180.0",
    "@privy-io/react-auth": "3.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "@types/three": "^0.180.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
