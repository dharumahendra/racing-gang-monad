# Default development: readonly mock. Production defaults to live.
VITE_DATA_MODE=mock
# Game backend must verify Privy access tokens before returning protected data.
VITE_API_URL=
# Leave blank to use viem's Monad testnet definition.
VITE_RPC_URL=
# Origin only; adapter appends /ws/play. Example: ws://127.0.0.1:3000
VITE_WS_URL=

# Public IDs from Privy dashboard. Never put an App Secret here.
VITE_PRIVY_APP_ID=cmviy1ioq027u0gjjyqt4vypt
VITE_PRIVY_CLIENT_ID=
