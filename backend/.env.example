# Salin ke backend/.env lalu isi. Jangan pernah commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATABASE_URL=./data/racing-gang.db

# Minimal 32 karakter acak, mis. hasil: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origin frontend. Host-nya dipakai sebagai domain SIWE.
PUBLIC_ORIGIN=http://localhost:5173
# Origin tambahan dipisah koma (opsional)
CORS_ORIGIN=

# Login utama: Google lewat Privy. Ambil dari dashboard Privy (Configuration > App settings).
# PRIVY_APP_ID sama dengan VITE_PRIVY_APP_ID di frontend.
PRIVY_APP_ID=
# Verification key (PEM). Boleh satu baris dengan \n literal:
# PRIVY_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----\nMFkw...\n-----END PUBLIC KEY-----
PRIVY_VERIFICATION_KEY=
# RAHASIA: hanya di backend/hosting, jangan pernah di frontend atau repo.
PRIVY_APP_SECRET=
PRIVY_API_URL=https://api.privy.io
# Login SIWE langsung dengan wallet, untuk bot (scripts/bot.ts) dan pengembangan. false di production.
ALLOW_SIWE_LOGIN=true

# Chain ID Monad testnet; cek ulang di dokumentasi resmi Monad.
CHAIN_ID=10143
# mock = chain palsu untuk dev; live = Monad testnet (butuh relayer/indexer dari Bayu)
CHAIN_MODE=mock
# local = seed dihitung server; event = seed diambil dari event RunStarted (BACKEND_PLAN H)
SEED_SOURCE=local

# Wajib saat CHAIN_MODE=live
MONAD_RPC_URL=
MONAD_WS_URL=
EXPLORER_URL=
ATTESTER_PRIVATE_KEY=
VOUCHER_SIGNER_PRIVATE_KEY=
RUN_REGISTRY_ADDRESS=
CAR_NFT_ADDRESS=
