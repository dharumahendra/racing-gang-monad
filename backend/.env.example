# Salin ke backend/.env lalu isi. Jangan pernah commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATABASE_URL=./data/racing-gang.db

# Minimal 32 karakter acak, mis. hasil: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origin frontend persis (skema+host+port). localhost dan 127.0.0.1 adalah origin berbeda;
# Vite default proyek ini berjalan di http://127.0.0.1:5173. Host-nya dipakai sebagai domain SIWE.
PUBLIC_ORIGIN=http://localhost:5173
# Origin tambahan dipisah koma (opsional)
CORS_ORIGIN=

# Login utama: Google lewat Privy. Ambil dari dashboard Privy (Configuration > App settings).
# PRIVY_APP_ID sama dengan VITE_PRIVY_APP_ID di frontend.
PRIVY_APP_ID=
# Verification key (PEM). Boleh satu baris dengan \n literal:
# PRIVY_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----\nMFkw...\n-----END PUBLIC KEY-----
PRIVY_VERIFICATION_KEY=
# Disarankan: URL JWKS publik (bukan rahasia). Bila diisi, dipakai untuk verifikasi dan mendukung rotasi kunci;
# PRIVY_VERIFICATION_KEY boleh dikosongkan. Contoh: https://auth.privy.io/api/v1/apps/<APP_ID>/jwks.json
PRIVY_JWKS_URL=
# RAHASIA: hanya di backend/hosting, jangan pernah di frontend atau repo.
PRIVY_APP_SECRET=
PRIVY_API_URL=https://api.privy.io
# Login SIWE langsung dengan wallet, untuk bot (scripts/bot.ts) dan pengembangan. false di production.
ALLOW_SIWE_LOGIN=true

# Chain ID Monad testnet; cek ulang di dokumentasi resmi Monad.
CHAIN_ID=10143
# mock = chain palsu untuk dev; live = Monad testnet (relayer, indexer, voucher signer ada di src/chain)
CHAIN_MODE=mock
# local = seed dihitung server; event = seed diambil dari event RunStarted (BACKEND_PLAN H)
SEED_SOURCE=local

# Wajib saat CHAIN_MODE=live
# Alamat kontrak ada di packages/config/deployments/monad-testnet.json. Kunci hanya di file .env server, jangan di chat.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_WS_URL=wss://testnet-rpc.monad.xyz
EXPLORER_URL=https://testnet.monadvision.com
ATTESTER_PRIVATE_KEY=
VOUCHER_SIGNER_PRIVATE_KEY=
RUN_REGISTRY_ADDRESS=0x5DF0f8c94BdcAeCAe74C3db606FfcE9EC09cBD93
CAR_NFT_ADDRESS=0x6Ac0e6D8e71D36fF31C61F391a4a7CFE2843654b
